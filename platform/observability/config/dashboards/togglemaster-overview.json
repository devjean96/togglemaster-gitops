      "title": "Restarts de containers (1h)",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Mostra o self-healing: pods recriados pelo rollout restart aparecem como 'pods novos'.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=\"togglemaster-homolog\"}[1h]))",
          "refId": "A",
          "legendFormat": "{{container}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count((time() - kube_pod_start_time{namespace=\"togglemaster-homolog\"}) < 600) or vector(0)",
          "refId": "B",
          "legendFormat": "pods novos (<10min)"
        }
